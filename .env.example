NODE_ENV=production
PORT=3002
LOG_LEVEL=INFO

DATABASE_URL=postgresql://user:password@postgres:5432/booking_db
PG_POOL_MAX=20

AUTH_SERVICE_URL=http://auth-service:3001
SHOP_SERVICE_URL=http://shop-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3005
CLIENT_URL=https://your-web-app.example
INTERNAL_EVENT_TOKEN=change-this-internal-event-token

JWT_PUBLIC_KEY_PATH=/run/secrets/jwtRS256.key.pub
JWT_ISSUER=salon-platform.auth
JWT_AUDIENCE=salon-platform.api
CORS_ALLOWED_ORIGINS=https://your-web-app.example

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PLATFORM_FEE_PERCENT=10
PLATFORM_FEE_PERCENT=10
PAYOUT_ENCRYPTION_KEY=generate-32-byte-hex

RABBITMQ_URL=amqp://user:password@rabbitmq:5672
